<?xml version="1.0" encoding="utf-8"?>
<!--
  新对话图标（v0.0.135 按参考图重画，二次修正）。

  用户给的参考图右侧是一枚**开口气泡**：粗圆头线画的近圆环，
  右下方留一个缺口、缺口下端收出一条小尾巴（ChatGPT 对话钮造型）。

  几何（48 视口，圆心 24,24，半径 13）：
  - 主弧从缺口上端（约 20°，点 36.2,28.4）逆时针绕 310° 到缺口下端
    （约 70°，点 28.4,36.2）——large-arc=1、sweep=0；
  - 尾巴从弧的下端往右下收一小段（到 33,42），圆角连接；
  - 描边 5.0（24dp 下 ≈2.5dp）与左侧菜单钮同口径，圆头线帽。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="48dp"
    android:height="48dp"
    android:viewportWidth="48"
    android:viewportHeight="48">

    <!-- 主弧：绕一大圈，右下方留缺口 -->
    <path
        android:pathData="M36.2,28.4 A13,13 0 1 0 28.4,36.2"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="6"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000" />

    <!-- 尾巴：缺口下端往右下收出 -->
    <path
        android:pathData="M28.4,36.2 L33,42.5"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="6"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000" />
</vector>
