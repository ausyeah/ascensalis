<?xml version="1.0" encoding="utf-8"?>
<!--
  启动图标前景（v0.0.98）：与应用内标志同一枚「书峰」，白标黑底。

  为什么是矢量替换掉那张 PNG：自适应图标在 API 26+ 只认这一个前景，
  旧 PNG 是给 API 25 以下准备的，而 minSdk 就是 26——它早就没被用过了。
  缩放 0.62 是为了让 96 视口的标志整体落在自适应图标 66dp 的安全圆内，
  否则圆形遮罩会把外环切掉一段。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <group
        android:scaleX="0.62"
        android:scaleY="0.62"
        android:pivotX="54"
        android:pivotY="54">
        <path
            android:pathData="M48,48 m-38,0 a38,38 0 1,0 76,0 a38,38 0 1,0 -76,0"
            android:fillColor="#00000000"
            android:strokeColor="#FFFFFFFF"
            android:strokeWidth="2.5" />
        <path
            android:fillColor="#FFFFFFFF"
            android:pathData="M48,26 L70,54 L70,66 L48,58 L26,66 L26,54 Z" />
        <path
            android:fillColor="#FFFFFFFF"
            android:pathData="M48,17.5 m-3.5,0 a3.5,3.5 0 1,0 7,0 a3.5,3.5 0 1,0 -7,0" />
    </group>
</vector>
