<?xml version="1.0" encoding="utf-8"?>
<!--
  应用标志（v0.0.98 第三稿）：环 + 摊开的书 + 拱成山峰的书页 + 峰顶书签。

  ## 这一稿怎么来的
  用图像模型抽了 7 轮概念稿（书峰、A 字书签、阶梯、山+日、丝带峰、
  展开书页、摊开的书），胜出的是「摊开的书」：两页书页拱成山峰、
  中缝是书脊、底部一条弧形书带、峰顶立一枚书签——
  「错题本」与「登临 / Ascensalis 的上升」两个比喻都钉在一枚标志里。
  比例经逐坐标光栅化预览校过：山宽而扁、中缝细、书带与山之间
  留一道弧形白缝（「合上的山、摊开的书」靠这道缝分开）。

  ## 为什么仍是纯单色
  空状态的标志颜色由界面按主题的 onSurface 染（浅色墨黑、深色纸白），
  启动图标则白标黑底。素材只留白色，谁用谁染。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="96dp"
    android:height="96dp"
    android:viewportWidth="96"
    android:viewportHeight="96">

    <!-- 外环：半径 38、线宽 2.5 -->
    <path
        android:pathData="M48,48 m-38,0 a38,38 0 1,0 76,0 a38,38 0 1,0 -76,0"
        android:fillColor="#00000000"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="2.5" />

    <!-- 峰顶书签：顶部 V 缺口 -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M44.5,16.5 L48,21.5 L51.5,16.5 L51.5,30.5 L44.5,30.5 Z" />

    <!-- 左右书页：拱成山峰，中缝即书脊（细缝，宽 2） -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M48,31.5 L18,66 Q33,68.5 47,68 Z" />
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M48,31.5 L78,66 Q63,68.5 49,68 Z" />

    <!-- 摊开的书：弧形书带，两端收尖，与书峰之间留一道白缝 -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M24,68 Q48,74.5 72,68 L72,72 Q48,80.5 24,72 Z" />
</vector>