<?xml version="1.0" encoding="utf-8"?>
<!--
  应用标志（v0.0.96）：细环 + 书签。

  为什么是这两样：
  - 书签是「把一页留住」的动作，正是错题本在做的事（把错题留下来反复看）；
  - 环把它框成一枚印章，小尺寸下不至于散成几个不相干的笔画。

  为什么是纯单色、不留任何固定颜色：
  空状态是用户见到这个 App 的第一眼，之前那条蓝色金鱼在深色主题下发亮、
  在浅色主题下发闷，两种主题下像两个不同的产品。这里只填白色/描白环，
  实际颜色由界面按当前主题的 onSurface 染色（见 ChatEmptyState），
  所以永远是「黑白」——浅色主题下是墨黑，深色主题下是纸白。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="96dp"
    android:height="96dp"
    android:viewportWidth="96"
    android:viewportHeight="96">

    <!-- 外环：半径 38、线宽 3，离边留 10，缩到 24dp 时也不会糊成一坨 -->
    <path
        android:pathData="M48,48 m-38,0 a38,38 0 1,0 76,0 a38,38 0 1,0 -76,0"
        android:fillColor="#00000000"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="3" />

    <!-- 书签：顶部两角 6 圆角，底部 45° 剪角，整体 28×44 -->
    <path
        android:pathData="M40,26 H56 A6,6 0 0 1 62,32 V70 L48,61 L34,70 V32 A6,6 0 0 1 40,26 Z"
        android:fillColor="#FFFFFFFF" />
</vector>