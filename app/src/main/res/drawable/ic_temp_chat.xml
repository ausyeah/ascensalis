<?xml version="1.0" encoding="utf-8"?>
<!--
  临时对话图标（v0.0.98）：虚线圆环 + 实心对话气泡。

  为什么是虚线圆环：临时对话的本质是「这段对话不长久」——
  用一个不闭合、随时会散掉的轮廓来表达，比一个实心圆更贴切，
  也和右上角其他实心图标拉开层次。虚线用八段圆弧拼出来：
  VectorDrawable 不支持 stroke dash，只能把「虚」画进路径里。

  气泡画成实心：虚线负责「临时」，实心负责「这是一段对话」，
  两者叠在一枚 24dp 的图标里才都读得出来。颜色由界面按主题染
  （灰色 = onSurfaceVariant），素材本身保持纯白。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="48dp"
    android:height="48dp"
    android:viewportWidth="48"
    android:viewportHeight="48">

    <!-- 虚线圆环：8 段 30° 弧，段间留 15° 缺口 -->
    <path
        android:pathData="M44,24 A20,20 0 0 1 41.32,34 M38.14,38.14 A20,20 0 0 1 29.18,43.32 M24,44 A20,20 0 0 1 14,41.32 M9.86,38.14 A20,20 0 0 1 0.68,29.18 M4,24 A20,20 0 0 1 6.68,14 M9.86,9.86 A20,20 0 0 1 18.82,4.68 M24,4 A20,20 0 0 1 34,6.68 M38.14,9.86 A20,20 0 0 1 43.32,14"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="2"
        android:strokeLineCap="round"
        android:fillColor="#00000000" />

    <!-- 对话气泡 -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M17.5,18.5 h13 a3.5,3.5 0 0 1 3.5,3.5 v6 a3.5,3.5 0 0 1 -3.5,3.5 h-7.2 l-4.3,4 v-4 h-1.5 a3.5,3.5 0 0 1 -3.5,-3.5 v-6 a3.5,3.5 0 0 1 3.5,-3.5 z" />
</vector>